# 每日巡检发信（一次性任务，跑完即退出）。
#
# 路径已按服务器仓库目录写好。若仓库换位置，改 WorkingDirectory、EnvironmentFile、ExecStart 三处。
# 确认 User= 与现有 hemu-oversea-fastapi.service 的运行用户一致（当前为 www）。
#
# 复制到 /etc/systemd/system/（在任意目录执行）：
#   sudo cp /www/project/xhm/projects/hemu_oversea/hemu_oversea_fullstack/server_files/hemu-daily-inspection.service /etc/systemd/system/
#   sudo cp /www/project/xhm/projects/hemu_oversea/hemu_oversea_fullstack/server_files/hemu-daily-inspection.timer /etc/systemd/system/
#
# 复制后在任意目录执行即可，不依赖当前工作目录：
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hemu-daily-inspection.timer
#
# 查看下次触发时间：
#   systemctl list-timers hemu-daily-inspection.timer
#
# 不想等到点、立刻试跑一轮（只跑这一次，不改变每天的计划）：
#   sudo systemctl start hemu-daily-inspection.service
#   sudo systemctl status hemu-daily-inspection.service
#   journalctl -u hemu-daily-inspection.service -n 100 --no-pager
#
# 不要对本单元设置 Restart=always，否则失败后会不停重跑并重复发信。
# 改的是 Python 代码时不用重启本单元；只有改了本文件或 .timer 才需要：
#   sudo systemctl daemon-reload
#   sudo systemctl restart hemu-daily-inspection.timer

[Unit]
Description=HeMu daily store inspection mail
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=www
WorkingDirectory=/www/project/xhm/projects/hemu_oversea/hemu_oversea_fullstack/hemu_oversea_fastapi
EnvironmentFile=-/www/project/xhm/projects/hemu_oversea/hemu_oversea_fullstack/hemu_oversea_fastapi/.env
ExecStart=/www/project/xhm/projects/hemu_oversea/hemu_oversea_fullstack/hemu_oversea_fastapi/.venv/bin/python -m app.jobs.daily_inspection
