# =============================================================================
# 服务器环境配置模板（阿里云 ECS）
# 用法：
#   1. 复制为同目录 .env（服务器上实际生效的文件名必须是 .env）
#      cp .env.server.example .env
#   2. 把下面标注「必改」的项填成真实值（首次 docker compose up 前完成）
#   3. 本文件可进 Git；填好密钥后的 .env / .env.server 不要提交
# 公网 IP 示例：106.15.239.152（若变更请全局替换）
# =============================================================================

# ---------- PostgreSQL（Compose 与应用共用）----------
POSTGRES_USER=postgres
# 【必改】强密码；仅在数据卷首次初始化时生效，与后面应用连库密码一致
POSTGRES_PASSWORD=请替换为服务器数据库强密码
POSTGRES_DB=hemu_oversea_fastapi
# 【保持】FastAPI 与 Docker Postgres 同机时用 localhost，不要写成公网 IP
POSTGRES_HOST=localhost
POSTGRES_PORT=5500
# 可选：RDS 等完整 DSN。非空时忽略上面的 POSTGRES_* 组装
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# ---------- 鉴权 / JWT ----------
# 【必改】很长的随机串，勿与本地开发相同
SECRET_KEY=请替换为很长的随机串
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 登录限流 ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---------- 验证码 ----------
CAPTCHA_LENGTH=4
CAPTCHA_EXPIRE_SECONDS=300

# ---------- 启动种子用户（仅 superadmin）----------
# 【必改】生产超管密码，勿用 123456
BOOTSTRAP_PASSWORD=请替换为超管强密码

# ---------- CORS（浏览器允许的前端源，JSON 数组）----------
# 【必改】必须与浏览器地址栏一致（协议+主机+端口）
# 前端经 Nginx 80 访问示例；若本地前端联调公网 API，再追加本机源
CORS_ORIGINS=["http://106.15.239.152"]
# 示例（多源）：
# CORS_ORIGINS=["http://106.15.239.152","http://localhost:8000","http://localhost:5173"]

# ---------- 敦煌开放平台 OAuth2 ----------
# 【按需】暂不用敦煌可留空；启用时须与开放平台白名单一致
DHGATE_APP_KEY=9UkPOMvgsY8BJDU6eoAT
DHGATE_APP_SECRET=PKCYx10A2NjDyn5i0qktcNBvOaf3VAcq
# 【启用敦煌时必改】后端 OAuth 回调（有 Nginx 反代时走 80；直连 API 则带 :8600）
DHGATE_REDIRECT_URI=http://106.15.239.152/api/v1/common/oauth/dhgate/callback
# 【启用敦煌时必改】授权完成后跳转的前端落地页
DHGATE_FRONTEND_REDIRECT_URI=http://106.15.239.152/callback
DHGATE_AUTHORIZE_URL=https://secure.dhgate.com/dop/oauth2/authorize
DHGATE_TOKEN_URL=https://secure.dhgate.com/dop/oauth2/access_token
DHGATE_API_URL=http://api.dhgate.com/dop/router
DHGATE_SANDBOX_API_URL=http://sandbox.api.dhgate.com/dop/router
# 生产一般 false；测试沙箱可 true
DHGATE_USE_SANDBOX=false
DHGATE_OAUTH_SCOPE=basic
DHGATE_OAUTH_STATE_TTL_MINUTES=10
DHGATE_TOKEN_REFRESH_BUFFER_MINUTES=5
