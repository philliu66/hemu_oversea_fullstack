# =============================================================================
# 服务器环境配置模板（阿里云 ECS + Nginx HTTPS）
# 用法：
#   1. 复制为同目录 .env（服务器上实际生效的文件名必须是 .env）
#      cp .env.server.example .env
#   2. 把下面标注「必改」的项填成真实值（首次 docker compose up 前完成）
#   3. 本文件可进 Git；填好密钥后的 .env / .env.server 不要提交
# 正式域名：https://hemuoversea.xiaohemu.net（www 同理）
# 公网 IP（备用参考）：106.15.239.152
# =============================================================================

# ---------- PostgreSQL（Compose 与应用共用）----------
POSTGRES_USER=postgres
# 【必改】强密码；仅在数据卷首次初始化时生效，与后面应用连库密码一致
POSTGRES_PASSWORD=请替换为服务器数据库强密码
POSTGRES_DB=hemu_oversea_fastapi
# 【保持】FastAPI 与 Docker Postgres 同机时用 localhost，不要写成公网 IP
POSTGRES_HOST=localhost
POSTGRES_PORT=5500
# 可选：RDS 等完整 DSN。非空时忽略上面的 POSTGRES_* 组装
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# ---------- 鉴权 / JWT ----------
# 【必改】很长的随机串，勿与本地开发相同
SECRET_KEY=请替换为很长的随机串
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 登录限流 ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---------- 验证码 ----------
CAPTCHA_LENGTH=4
CAPTCHA_EXPIRE_SECONDS=300

# ---------- 启动种子用户（仅 superadmin）----------
# 【必改】生产超管密码，勿用 123456
BOOTSTRAP_PASSWORD=请替换为超管强密码

# ---------- CORS（浏览器允许的前端源，JSON 数组）----------
# 【必改】必须与浏览器地址栏一致（协议+主机+端口）；同域 Nginx HTTPS 如下
CORS_ORIGINS=["https://hemuoversea.xiaohemu.net","https://www.hemuoversea.xiaohemu.net"]
# 本机前端联调公网 API 时可追加，例如：
# CORS_ORIGINS=["https://hemuoversea.xiaohemu.net","https://www.hemuoversea.xiaohemu.net","http://localhost:8000"]

# ---------- 敦煌开放平台 OAuth2 ----------
# 【按需】密钥只写在服务器 .env，不要提交真实值
DHGATE_APP_KEY=
DHGATE_APP_SECRET=
# 【启用敦煌时必改】须与开放平台白名单一致（HTTPS + 域名，经 Nginx 反代 /api/）
DHGATE_REDIRECT_URI=https://hemuoversea.xiaohemu.net/api/v1/common/oauth/dhgate/callback
DHGATE_FRONTEND_REDIRECT_URI=https://hemuoversea.xiaohemu.net/admin/callback
DHGATE_AUTHORIZE_URL=https://secure.dhgate.com/dop/oauth2/authorize
DHGATE_TOKEN_URL=https://secure.dhgate.com/dop/oauth2/access_token
DHGATE_API_URL=http://api.dhgate.com/dop/router
DHGATE_SANDBOX_API_URL=http://sandbox.api.dhgate.com/dop/router
# 生产一般 false；测试沙箱可 true
DHGATE_USE_SANDBOX=false
DHGATE_OAUTH_SCOPE=basic
DHGATE_OAUTH_STATE_TTL_MINUTES=10
DHGATE_TOKEN_REFRESH_BUFFER_MINUTES=5

# ---------- 阿里云 RAM / 邮件推送 DirectMail ----------
# 【必改】密钥只写在服务器 .env，不要提交真实值
ALIYUN_RAM_ACCESS_KEY_ID=
ALIYUN_RAM_ACCESS_KEY_SECRET=
# 【必改】控制台已验证的发信地址
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_REGION_ID=cn-hangzhou
ALIYUN_DM_ENDPOINT=dm.aliyuncs.com
ALIYUN_DM_ADDRESS_TYPE=1
ALIYUN_DM_REPLY_TO_ADDRESS=true
