# ---------- PostgreSQL（Compose 与应用共用）----------
# docker compose 会读取同目录 .env 做变量替换；应用 Settings 用相同变量组装连接串
# 服务器部署请优先参考 .env.server.example，复制为 .env 后再改「必改」项
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hemu_oversea_fastapi
# 应用连接地址：同机 Docker 用 localhost；连远程库改为服务器 IP/域名
POSTGRES_HOST=localhost
# 宿主机映射端口（compose: "${POSTGRES_PORT}:5432"）
POSTGRES_PORT=5500
# 可选：完整 DSN 覆盖（如阿里云 RDS）。设置后忽略上面的 POSTGRES_* 组装结果
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# ---------- 鉴权 / JWT ----------
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 登录限流 ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---------- 验证码 ----------
CAPTCHA_LENGTH=4
CAPTCHA_EXPIRE_SECONDS=300

# ---------- 启动种子用户（仅 superadmin）----------
BOOTSTRAP_PASSWORD=123456

# ---------- CORS（浏览器允许的前端源，JSON 数组）----------
CORS_ORIGINS=["http://localhost:5173"]

# ---------- 敦煌开放平台 OAuth2 ----------
DHGATE_APP_KEY=
DHGATE_APP_SECRET=
DHGATE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/common/oauth/dhgate/callback
DHGATE_FRONTEND_REDIRECT_URI=http://localhost:8000/admin/callback
DHGATE_AUTHORIZE_URL=https://secure.dhgate.com/dop/oauth2/authorize
DHGATE_TOKEN_URL=https://secure.dhgate.com/dop/oauth2/access_token
DHGATE_API_URL=http://api.dhgate.com/dop/router
DHGATE_SANDBOX_API_URL=http://sandbox.api.dhgate.com/dop/router
DHGATE_USE_SANDBOX=false
DHGATE_OAUTH_SCOPE=basic
DHGATE_OAUTH_STATE_TTL_MINUTES=10
DHGATE_TOKEN_REFRESH_BUFFER_MINUTES=5
