# ---------- PostgreSQL（Compose 与应用共用）----------
# docker compose 会读取同目录 .env 做变量替换；应用 Settings 用相同变量组装连接串
# 服务器部署请优先参考 .env.server.example，复制为 .env 后再改「必改」项
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hemu_oversea_fastapi
# 应用连接地址：同机 Docker 用 localhost；连远程库改为服务器 IP/域名
POSTGRES_HOST=localhost
# 宿主机映射端口（compose: "${POSTGRES_PORT}:5432"）
POSTGRES_PORT=5500
# 可选：完整 DSN 覆盖（如阿里云 RDS）。设置后忽略上面的 POSTGRES_* 组装结果
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# ---------- 鉴权 / JWT ----------
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 登录限流 ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---------- 登录日志切段 ----------
# 距上次计入的活跃不足该分钟数则不写库。空闲分钟应大于节流分钟。
LOGIN_LOG_TOUCH_MINUTES=5
# 距上次计入的活跃达到该分钟数，结束本段并在下次请求时新开一条
LOGIN_LOG_IDLE_MINUTES=15

# ---------- 验证码 ----------
CAPTCHA_LENGTH=4
CAPTCHA_EXPIRE_SECONDS=300

# ---------- 启动种子用户（仅 superadmin）----------
BOOTSTRAP_PASSWORD=123456

# ---------- CORS（浏览器允许的前端源，JSON 数组）----------
CORS_ORIGINS=["http://localhost:5173"]

# ---------- 敦煌开放平台 OAuth2 ----------
DHGATE_APP_KEY=
DHGATE_APP_SECRET=
DHGATE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/common/oauth/dhgate/callback
DHGATE_FRONTEND_REDIRECT_URI=http://localhost:8000/admin/callback
DHGATE_AUTHORIZE_URL=https://secure.dhgate.com/dop/oauth2/authorize
DHGATE_TOKEN_URL=https://secure.dhgate.com/dop/oauth2/access_token
DHGATE_API_URL=http://api.dhgate.com/dop/router
DHGATE_SANDBOX_API_URL=http://sandbox.api.dhgate.com/dop/router
DHGATE_USE_SANDBOX=false
DHGATE_OAUTH_SCOPE=basic
DHGATE_OAUTH_STATE_TTL_MINUTES=10
DHGATE_TOKEN_REFRESH_BUFFER_MINUTES=5

# ---------- TikTok Shop 卖家授权 ----------
# 密钥只写在本地 .env，勿提交真实值
# 授权链接只带 service_id 和 state，不传 redirect_uri
# 回调地址在 Partner Center 配置，例如：
# http://127.0.0.1:8000/api/v1/common/oauth/tiktok/callback
# 美国应用把 AUTHORIZE_URL 改为
# https://services.us.tiktokshop.com/open/authorize
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
TIKTOK_AUTHORIZE_URL=https://services.tiktokshop.com/open/authorize
TIKTOK_AUTH_BASE_URL=https://auth.tiktok-shops.com
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_OAUTH_STATE_TTL_MINUTES=10
# 仅测试店铺使用。测试授权回调不带 state 时，用这个值去 store_tts_oauth_pending 匹配供应商。
# 须与手动插入的 pending.state 一致，最长 20 字符。正式授权回调自带 state，留空。
TIKTOK_AUTH_TEST_STORE_STATE=

# ---------- 阿里云 RAM / 邮件推送 DirectMail ----------
# 【必填】仅写在本地/服务器 .env，勿提交真实值
ALIYUN_RAM_ACCESS_KEY_ID=
ALIYUN_RAM_ACCESS_KEY_SECRET=
# 【必填】控制台已验证的发信地址
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_REGION_ID=cn-hangzhou
ALIYUN_DM_ENDPOINT=dm.aliyuncs.com
# 0=随机账号；1=发信地址
ALIYUN_DM_ADDRESS_TYPE=1
# 是否启用控制台已验证的回信地址
ALIYUN_DM_REPLY_TO_ADDRESS=true
